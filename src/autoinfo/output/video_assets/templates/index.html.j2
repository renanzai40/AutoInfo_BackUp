<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=1920, height=1080" />
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
  <style>
    /* Theme variables — injected from theme_palettes.json */
    :root {
      --bg: {{ theme.bg }};
      --bg-soft: {{ theme.bg_soft }};
      --surface: {{ theme.surface }};
      --surface-2: {{ theme.surface_2 }};
      --border: {{ theme.border }};
      --text-1: {{ theme.text_1 }};
      --text-2: {{ theme.text_2 }};
      --text-3: {{ theme.text_3 }};
      --accent: {{ theme.accent }};
      --accent-2: {{ theme.accent_2 }};
      --good: {{ theme.good }};
      --warn: {{ theme.warn }};
      --bad: {{ theme.bad }};
      --grad: {{ theme.grad }};
      --radius: {{ theme.radius }};
      --radius-lg: {{ theme.radius_lg }};
      --shadow: {{ theme.shadow }};
      --font-sans: system-ui, sans-serif;
      --font-display: {{ theme.font_display }};
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { margin: 0; width: 1920px; height: 1080px; overflow: hidden; }
    body { background: var(--bg); color: var(--text-1); font-family: var(--font-sans); }
  </style>
</head>
<body>
  <!-- Root composition — audio + scene orchestration -->
  <div id="root" data-composition-id="main"
       data-start="0" data-duration="{{ total_duration }}"
       data-width="1920" data-height="1080">

    <!-- Audio — narration (must have id, else silent render) -->
    {% if has_audio %}<audio class="clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="0"
           src="assets/audio/narration.mp3" id="narration-audio"></audio>
    {% endif %}

    <!-- Sub-scenes — each host's data-composition-id must match its composition -->
    {% for scene in scenes %}<div class="clip" data-start="{{ scene.start }}" data-duration="{{ scene.duration }}" data-track-index="{{ loop.index }}"
         data-composition-src="compositions/{{ '%02d' % loop.index }}-scene.html"
         data-composition-id="scene-{{ loop.index }}" id="s{{ loop.index }}"></div>
    {% endfor %}
  </div>

  <!-- Root timeline — register even if empty -->
  <script>
    window.__timelines = window.__timelines || {};
    window.__timelines["main"] = gsap.timeline({ paused: true });
  </script>
</body>
</html>
